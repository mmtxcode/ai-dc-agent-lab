{
  "inputs": [
    { "id": "nd-api-key", "type": "promptString", "description": "Nexus Dashboard API key", "password": true },
    { "id": "nd-user", "type": "promptString", "description": "Nexus Dashboard username" },
    { "id": "nd-host", "type": "promptString", "description": "Nexus Dashboard IP or hostname" }
  ],
  "servers": {
    "intersight": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/mcp_servers/intersight_server.py"]
    },
    "aci": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/mcp_servers/aci_server.py"]
    },
    "report": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/mcp_servers/report_server.py"]
    },
    "nd": {
      "type": "http",
      "url": "https://${input:nd-host}/api/v1/mcp",
      "headers": {
        "X-Nd-Apikey": "${input:nd-api-key}",
        "X-Nd-Username": "${input:nd-user}"
      }
    }
  }
}
