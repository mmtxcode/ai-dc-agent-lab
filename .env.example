# Copy to .env and fill in. .env is in .gitignore — never commit it.

# ---- AI model (Gemini 3.1 Flash Lite via your AI gateway) ----
# Matches the working curl test: api-key header, app key inside "user" as JSON.
# Change LLM_BASE_URL to your gateway; LLM_URL is built from it automatically.
LLM_BASE_URL=https://CHANGE-ME              # e.g. https://ai.example.com  (no trailing slash)
LLM_DEPLOYMENT=gemini-3.1-flash-lite
LLM_URL=${LLM_BASE_URL}/openai/deployments/${LLM_DEPLOYMENT}/chat/completions
LLM_FORMAT=openai
LLM_MODEL=${LLM_DEPLOYMENT}
LLM_SEND_MODEL=false            # model is already in the URL
LLM_API_KEY=CHANGE-ME           # the value you send as the api-key header
LLM_API_KEY_HEADER=api-key
LLM_APP_KEY=CHANGE-ME           # sent as  "user": "{\"appkey\": \"<this>\"}"
LLM_APP_KEY_FIELD=user
LLM_APP_KEY_JSON_KEY=appkey
LLM_STOP=<|im_end|>
LLM_API_VERSION=                # only if the gateway asks for ?api-version=
LLM_VERIFY_TLS=true

# ---- Intersight (read-only key) ----
INTERSIGHT_BASE_URL=https://intersight.com
INTERSIGHT_KEY_ID=CHANGE-ME
INTERSIGHT_SECRET_KEY_FILE=C:\lab\keys\intersight.pem

# ---- ACI simulator ----
APIC_URL=https://CHANGE-ME
APIC_USER=admin
APIC_PASSWORD=CHANGE-ME
APIC_VERIFY_TLS=false

# ---- Nexus Dashboard 4.3.1 (built-in MCP server at /api/v1/mcp) ----
ND_URL=https://CHANGE-ME          # no trailing slash
ND_USER=CHANGE-ME                 # user the API key belongs to (its RBAC applies)
ND_API_KEY=CHANGE-ME              # ND: user menu > Manage API keys > Add API key
ND_VERIFY_TLS=false               # lab only; production = CA-signed cert + true

# ---- Agent behaviour ----
AGENT_MAX_STEPS=12
AGENT_AUTO_APPROVE=false        # keep false for the lab: writes need a human "y"
AGENT_SHOW_RESULTS=true         # print a preview of each tool result
