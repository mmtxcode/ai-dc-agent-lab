# Copy to .env and fill in. .env is in .gitignore — never commit it.

# ---- AI model (Gemini 3.1 Flash) ----
LLM_URL=https://CHANGE-ME
LLM_FORMAT=openai               # openai | gemini  (run scripts/test_llm_toolcall.py to find out)
LLM_MODEL=gemini-3.1-flash
LLM_BEARER_TOKEN=CHANGE-ME
LLM_APP_KEY=CHANGE-ME
LLM_APP_KEY_HEADER=             # set ONE of these two, per the endpoint docs
LLM_APP_KEY_FIELD=
LLM_VERIFY_TLS=true

# ---- Intersight (read-only key) ----
INTERSIGHT_BASE_URL=https://intersight.com
INTERSIGHT_KEY_ID=CHANGE-ME
INTERSIGHT_SECRET_KEY_FILE=C:\lab\keys\intersight.pem

# ---- ACI simulator ----
APIC_URL=https://CHANGE-ME
APIC_USER=admin
APIC_PASSWORD=CHANGE-ME
APIC_VERIFY_TLS=false

# ---- Nexus Dashboard ----
ND_URL=https://CHANGE-ME
ND_USER=admin
ND_PASSWORD=CHANGE-ME
ND_DOMAIN=DefaultAuth
ND_VERIFY_TLS=false
# Check these two in https://<nd>/help-center/swagger/ and adjust
ND_SWITCHES_PATH=/api/v1/manage/fabrics/{fabric}/switches
ND_ANOMALIES_PATH=/api/v1/analyze/anomalies

# ---- Agent behaviour ----
AGENT_MAX_STEPS=12
AGENT_AUTO_APPROVE=false        # keep false for the lab: writes need a human "y"
AGENT_SHOW_RESULTS=true         # print a preview of each tool result
